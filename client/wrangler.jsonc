{
  "name": "pidor",
  "main": "../server/cloudflare-worker.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ws",
      "/health",
      "/telegram/*",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PidorRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "LobbyDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PidorRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "LobbyDirectory"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
